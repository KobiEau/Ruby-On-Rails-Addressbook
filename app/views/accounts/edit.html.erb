<%# app/views/accounts/edit.html.erb %>

<div class="max-w-lg mx-auto py-[var(--spacing-8)] px-[var(--spacing-4)]">

  <%# Back link %>
  <%= render "shared/back_link", text: "← Back to Account", path: account_path %>

  <%# Form card %>
  <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] p-[var(--spacing-6)]">

    <h1 class="text-lg font-bold text-[var(--color-text-heading)] mb-[var(--spacing-6)]">Edit Profile</h1>

    <%# Error block %>
    <%= render "shared/error_block", record: @user, message: "prevented your profile from being saved" %>

    <%= form_with model: @user, url: account_path, method: :patch do |form| %>

      <%# Firstname %>
      <div class="mb-[var(--spacing-4)]">
        <%= form.label :firstname, "First Name",
              class: "block text-sm font-semibold text-[var(--color-label)] mb-[var(--spacing-2)]" %>
        <%= form.text_field :firstname,
              placeholder: "First name",
              class: "w-full px-[var(--spacing-3)] py-[var(--spacing-2)]
                      bg-[var(--color-input-bg)]
                      border border-[var(--color-input-border)]
                      rounded-[var(--radius-md)]
                      text-sm text-[var(--color-text-heading)]
                      focus:outline-none focus:ring-2 focus:ring-[var(--color-input-focus)]" %>
      </div>

      <%# Lastname %>
      <div class="mb-[var(--spacing-6)]">
        <%= form.label :lastname, "Last Name",
              class: "block text-sm font-semibold text-[var(--color-label)] mb-[var(--spacing-2)]" %>
        <%= form.text_field :lastname,
              placeholder: "Last name",
              class: "w-full px-[var(--spacing-3)] py-[var(--spacing-2)]
                      bg-[var(--color-input-bg)]
                      border border-[var(--color-input-border)]
                      rounded-[var(--radius-md)]
                      text-sm text-[var(--color-text-heading)]
                      focus:outline-none focus:ring-2 focus:ring-[var(--color-input-focus)]" %>
      </div>

      <%# Actions %>
      <div class="flex items-center justify-between">
        <%= link_to "Cancel", account_path,
              class: "text-sm font-semibold text-[var(--color-text-muted)]
                      hover:text-[var(--color-text-base)]
                      transition-colors duration-200" %>
        <%= form.submit "Save Changes",
              class: "px-[var(--spacing-4)] py-[var(--spacing-2)]
                      bg-[var(--color-accent)]
                      hover:bg-[var(--color-accent-hover)]
                      text-[var(--color-text-on-accent)]
                      text-sm font-semibold
                      rounded-[var(--radius-md)]
                      shadow-[var(--shadow-btn)]
                      transition-colors duration-200
                      cursor-pointer" %>
      </div>

    <% end %>
  </div>

</div>