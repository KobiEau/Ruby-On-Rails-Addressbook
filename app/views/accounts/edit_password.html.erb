<%# app/views/accounts/edit_password.html.erb %>

<div class="max-w-lg mx-auto py-[var(--spacing-8)] px-[var(--spacing-4)]">

  <%# Back link %>
  <%= render "shared/back_link", text: "← Back to Account", path: account_path %>

  <%# Form card %>
  <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] p-[var(--spacing-6)]">

    <h1 class="text-lg font-bold text-[var(--color-text-heading)] mb-[var(--spacing-2)]">Change Password</h1>
    <p class="text-sm text-[var(--color-text-muted)] mb-[var(--spacing-6)]">
      Choose a strong password you don't use anywhere else
    </p>

    <%# Error block %>
    <%= render "shared/error_block", record: @user, message: "prevented your password from being updated" %>

    <%= form_with model: @user, url: update_password_account_path, method: :patch do |form| %>

      <%# Current password %>
      <div class="mb-[var(--spacing-4)]">
        <%= form.label :current_password, "Current Password",
              class: "block text-sm font-semibold text-[var(--color-label)] mb-[var(--spacing-2)]" %>
        <%= render "shared/password_field",
              form: form,
              field_name: :current_password,
              placeholder: "Enter your current password" %>
      </div>

      <%# Divider %>
      <div class="border-t border-[var(--color-border-subtle)] my-[var(--spacing-4)]"></div>

      <%# New password %>
      <div class="mb-[var(--spacing-4)]">
        <%= form.label :password, "New Password",
              class: "block text-sm font-semibold text-[var(--color-label)] mb-[var(--spacing-2)]" %>
        <%= render "shared/password_field",
              form: form,
              field_name: :password,
              placeholder: "Enter new password" %>
      </div>

      <%# Confirm new password %>
      <div class="mb-[var(--spacing-6)]">
        <%= form.label :password_confirmation, "Confirm New Password",
              class: "block text-sm font-semibold text-[var(--color-label)] mb-[var(--spacing-2)]" %>
        <%= render "shared/password_field",
              form: form,
              field_name: :password_confirmation,
              placeholder: "Confirm new password" %>
      </div>

      <%# Actions %>
      <div class="flex items-center justify-between">
        <%= link_to "Cancel", account_path,
              class: "text-sm font-semibold text-[var(--color-text-muted)]
                      hover:text-[var(--color-text-base)]
                      transition-colors duration-200" %>
        <%= form.submit "Update Password",
              class: "px-[var(--spacing-4)] py-[var(--spacing-2)]
                      bg-[var(--color-accent)]
                      hover:bg-[var(--color-accent-hover)]
                      text-[var(--color-text-on-accent)]
                      text-sm font-semibold
                      rounded-[var(--radius-md)]
                      shadow-[var(--shadow-btn)]
                      transition-colors duration-200
                      cursor-pointer" %>
      </div>

    <% end %>
  </div>

</div>