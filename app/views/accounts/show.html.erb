<%# app/views/accounts/show.html.erb %>

<div class="max-w-lg mx-auto py-[var(--spacing-8)] px-[var(--spacing-4)] space-y-[var(--spacing-4)]">

  <%# Header card %>
  <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] p-[var(--spacing-6)]">
    <div class="flex items-center gap-[var(--spacing-4)]">
      <div class="w-16 h-16 rounded-[var(--radius-full)] bg-[var(--color-accent-subtle)] flex items-center justify-center">
        <span class="text-xl font-bold text-[var(--color-accent)]">
          <%= current_user.firstname[0].upcase %><%= current_user.lastname[0].upcase %>
        </span>
      </div>
      <div>
        <h1 class="text-lg font-bold text-[var(--color-text-heading)]">
          <%= current_user.firstname %> <%= current_user.lastname %>
        </h1>
        <p class="text-sm text-[var(--color-text-muted)]"><%= current_user.email %></p>
      </div>
    </div>
  </div>

  <%# Profile card %>
  <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] p-[var(--spacing-6)]">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-bold text-[var(--color-text-heading)]">Profile</h2>
        <p class="text-sm text-[var(--color-text-muted)]">Edit your display name</p>
      </div>
      <%= link_to "Edit →", edit_account_path,
            class: "text-sm font-semibold text-[var(--color-accent)]
                    hover:text-[var(--color-accent-hover)]
                    transition-colors duration-200" %>
    </div>
  </div>

  <%# Security card %>
  <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] p-[var(--spacing-6)]">
    <div class="mb-[var(--spacing-4)]">
      <h2 class="text-sm font-bold text-[var(--color-text-heading)]">Security</h2>
      <p class="text-sm text-[var(--color-text-muted)]">Manage your email and password</p>
    </div>
    <div class="flex flex-col gap-[var(--spacing-3)] border-t border-[var(--color-border-subtle)] pt-[var(--spacing-4)]">
      <div class="flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-body)]">Email address</span>
        <%= link_to "Change →", edit_email_account_path,
              class: "text-sm font-semibold text-[var(--color-accent)]
                      hover:text-[var(--color-accent-hover)]
                      transition-colors duration-200" %>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-body)]">Password</span>
        <%= link_to "Change →", edit_password_account_path,
              class: "text-sm font-semibold text-[var(--color-accent)]
                      hover:text-[var(--color-accent-hover)]
                      transition-colors duration-200" %>
      </div>
    </div>
  </div>

  <%# Your Data card %>
  <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] p-[var(--spacing-6)]">
    <div class="mb-[var(--spacing-4)]">
      <h2 class="text-sm font-bold text-[var(--color-text-heading)]">Your Data</h2>
      <p class="text-sm text-[var(--color-text-muted)]">Import or export your contacts</p>
    </div>
    <div class="flex flex-col gap-[var(--spacing-3)] border-t border-[var(--color-border-subtle)] pt-[var(--spacing-4)]">
      <div class="flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-body)]">Import contacts from CSV</span>
        <%= link_to "Import →", import_contacts_path,
              class: "text-sm font-semibold text-[var(--color-accent)]
                      hover:text-[var(--color-accent-hover)]
                      transition-colors duration-200" %>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-body)]">Export contacts to CSV</span>
        <%= link_to "Export →", export_contacts_path,
              class: "text-sm font-semibold text-[var(--color-accent)]
                      hover:text-[var(--color-accent-hover)]
                      transition-colors duration-200" %>
      </div>
    </div>
  </div>

  <%# Danger Zone card %>
  <div class="bg-[var(--color-error-bg)] border border-[var(--color-error-border)] rounded-[var(--radius-lg)] p-[var(--spacing-6)]">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-bold text-[var(--color-error-text)]">Danger Zone</h2>
        <p class="text-sm text-[var(--color-error-text)] opacity-75">Permanently delete your account and all contacts</p>
      </div>
      <%= link_to "Delete Account →", danger_account_path,
            class: "text-sm font-semibold text-[var(--color-danger)]
                    hover:text-[var(--color-danger-hover)]
                    transition-colors duration-200" %>
    </div>
  </div>

</div>