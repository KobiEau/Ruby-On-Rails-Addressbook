<%= form_with model:[:admin, contact], local:true, class:"space-y-4" do|form| %>
  <%= render "shared/error_block", record: contact,
   message: "prevented this contact from being saved" %>

  <%# Owner %>
  <div>
    <%= form.label :user_id, "Owner",
          class:"block text-sm font-semibold 
                mb-[var(--spacing-2)] text-[var(--color-label)]"%>
    <%= form.collection_select :user_id, users, :id, :fullname,
        {prompt: "Select a user"},
        {
        class:"w-full px-3 py-2 text-sm
              bg-[var(--color-input-bg)]
              border border-[var(--color-input-border)]
              rounded-[var(--radius-md)]
              text-[var(--color-text-heading)]
              focus:outline-none
              focus:ring-2 focus:ring-[var(--color-input-focus)]
              focus:border-[var(--color-input-focus)]"} %>
  </div>

  <%# Name row %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :firstname, "First Name",
          class:"block text-sm font-semibold 
          mb-[var(--spacing-2)] text-[var(--color-label)]"%>
      <%= form.text_field :firstname,
          placeholder:"Jane",
          class:"w-full px-3 py-2 text-sm
                bg-[var(--color-input-bg)]
                border border-[var(--color-input-border)]
                rounded-[var(--radius-md)]
                text-[var(--color-text-heading)]
                placeholder:text-[var(--color-text-muted)]
                focus:outline-none
                focus:ring-2 focus:ring-[var(--color-input-focus)]
                focus:border-[var(--color-input-focus)]"%>
    </div>
    <div>
      <%= form.label :lastname, "Last Name",
          class:"block text-sm font-semibold 
          mb-[var(--spacing-2)] text-[var(--color-label)]"%>
      <%= form.text_field :lastname,
          placeholder:"Doe",
          class:"w-full px-3 py-2 text-sm
                bg-[var(--color-input-bg)]
                border border-[var(--color-input-border)]
                rounded-[var(--radius-md)]
                text-[var(--color-text-heading)]
                placeholder:text-[var(--color-text-muted)]
                focus:outline-none
                focus:ring-2 focus:ring-[var(--color-input-focus)]
                focus:border-[var(--color-input-focus)]"%>
    </div>
  </div>

  <%# Phone + Category %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :phone_number, "Phone Number",
          class: "block text-sm font-semibold mb-[var(--spacing-2)]
            text-[var(--color-label)]"%>
      <%= form.text_field :phone_number,
          maxlength:10,
          pattern:"0[235][0-9]{8}",
          inputmode: "numeric",
          placeholder:"e.g 0244123452",
          class: "w-full px-3 py-2 text-sm
                    bg-[var(--color-input-bg)]
                    border border-[var(--color-input-border)]
                    rounded-[var(--radius-md)]
                    text-[var(--color-text-heading)]
                    placeholder:text-[var(--color-text-muted)]
                    focus:outline-none
                    focus:ring-2 focus:ring-[var(--color-input-focus)]
                    focus:border-[var(--color-input-focus)]"%>
    </div>
    <div>
      <%=form.label :category, "Category",
          class:"block text-sm font-semibold mb-[var(--spacing-2)]
                text-[var(--color-label)]"%>
      <%=form.select :category, Contact::CATEGORIES,
         {prompt:"Select a category"},
         {
           class: "w-full px-3 py-2 text-sm
                    bg-[var(--color-input-bg)]
                    border border-[var(--color-input-border)]
                    rounded-[var(--radius-md)]
                    text-[var(--color-text-heading)]
                    placeholder:text-[var(--color-text-muted)]
                    focus:outline-none
                    focus:ring-2 focus:ring-[var(--color-input-focus)]
                    focus:border-[var(--color-input-focus)]"}  %>
    </div>
  </div>

  <%# Actions %>
  <div class="flex items-center justify-between pt-[var(--spacing-2)]">
    <%=form.submit contact.persisted? ? "Save Changes" : "Create Contact",
        class:"px-4 py-2 text-sm font-bold
        bg-[var(--color-accent)]
        hover:bg-[var(--color-accent-hover)]
        text-[var(--color-text-on-accent)]
        rounded-[var(--radius-md)] shadow-[var(--shadow-btn)]
        cursor-pointer transition duration-200"
    %>
    <%=link_to "Cancel", admin_contacts_path,
        class:"px-4 py-2
              text-sm font-medium
             text-[var(--color-text-muted)]
             rounded-[var(--radius-md)]
            border border-[var(--color-border-subtle)]
            bg-[var(--color-surface-base)]
            text-sm font-medium
            text-[var(--color-text-muted)]
            hover:bg-[var(--color-surface-muted)]
            transition-colors duration-200"
    %>
  </div>
<% end %>