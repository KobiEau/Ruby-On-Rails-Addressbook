<div class="max-w-2xl mx-auto space-y-4 px-4 sm:px-0">

  <%= render "shared/back_link", text:"← Back to Contacts",path: admin_contacts_path%>
  <div class="bg-[var(--color-surface-card)] border border-[var(--color-border-subtle)]
              rounded-[var(--radius-lg)] shadow-[var(--shadow-card)] p-4 sm:p-6">
    <h1 class="text-lg font-bold text-[var(--color-text-heading)]
               mb-[var(--spacing-6)]">Edit Contact</h1>
    <%= render "form", contact: @contact, users: @users %>
  </div>

</div>