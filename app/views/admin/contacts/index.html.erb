<% content_for :page_title, "Contacts" %>
<div class="space-y-4" data-controller="export"
data-export-delete-url="<%= bulk_destroy_admin_contacts_path%>"
data-export-export-url="<%= export_selected_admin_contacts_path%>">
  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-[var(--color-text-heading)]">Contacts</h1>
      <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
        <%= @contacts.total_count %> total contacts
      </p>
    </div>
  </div>

  <%# Toolbar %>
  <div class="flex items-center justify-between gap-3">

    <%# Search %>
    <%= form_with url: admin_contacts_path, method: :get, local: true,
          class: "flex items-center gap-3" do |form| %>
      <%= form.text_field :search,
            value: params[:search],
            placeholder: "Search by name, phone or owner email...",
            class: "w-72 px-3 py-1.5 text-xs
                    bg-[var(--color-surface-card)]
                    border border-[var(--color-border-subtle)]
                    rounded-[var(--radius-md)]
                    text-[var(--color-text-heading)]
                    placeholder:text-[var(--color-text-muted)]
                    focus:outline-none
                    focus:ring-1 focus:ring-[var(--color-accent)]
                    focus:border-[var(--color-accent)]" %>
      <%= form.submit "Search",
            class: "px-3 py-1.5 text-xs font-medium
                    bg-[var(--color-btn-secondary)]
                    text-white
                    rounded-[var(--radius-md)]
                    cursor-pointer
                    hover:bg-[var(--color-btn-secondary-hover)]
                    transition-colors duration-200" %>
      <% if params[:search].present? %>
        <%= link_to "✕ Clear", admin_contacts_path,
              class: "text-xs text-[var(--color-text-muted)]
                      hover:text-[var(--color-danger)]
                      transition-colors duration-200" %>
      <% end %>
    <% end %>

    <%# New Contact %>
    <%= link_to "+ New Contact", new_admin_contact_path,
          class: "px-3 py-1.5 text-sm font-bold
                  bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)]
                  text-[var(--color-text-on-accent)]
                  rounded-[var(--radius-md)]
                  shadow-[var(--shadow-btn)]
                  transition duration-200" %>
  </div>

<%# Selection Toolbar — hidden until checkboxes are ticked %>
  <div class="flex items-center gap-3 h-8">
    <a id="export-btn"
       class="hidden px-3 py-1.5 text-xs font-medium
              border border-[var(--color-border-subtle)]
              rounded-[var(--radius-md)]
              text-[var(--color-text-muted)]
              opacity-40 pointer-events-none cursor-not-allowed
              hover:bg-[var(--color-accent)]
              hover:text-white
              transition-colors duration-200">
      Export Selected 
    </a>
    <button id="uncheck-btn"
            type="button"
            data-action="click->export#uncheckAll"
            class="hidden text-xs py-1.5 px-3 font-medium
                  border border-[var(--color-warning)]
                  rounded-[var(--radius-md)]
                   text-[var(--color-text-muted)]
                   hover:bg-[var(--color-warning)]
                  hover:text-white
                   transition-colors duration-200">
      ✕ Uncheck all
    </button>
     <%# <a id="export-btn",
      class="shrink-0 px-4 py-2 rounded-[var(--radius-md)]
              outline outline-[var(--color-accent)]
              text-[var(--color-text-on-accent)]
              font-semibold text-sm
              hover:text-[var(--color-text-muted)]
              transition-colors duration-200
              disabled:opacity-40 disabled:pointer-events-none"> Export Selected New
     </a> %>
    <a id="delete-btn"
        type="button"
        data-action="click->export#deleteSelected"
        class="hidden px-3 py-1.5 text-xs font-medium
                rounded-[var(--radius-md)]
                text-[var(--color-danger)]
                border border-[var(--color-danger)]
                hover:bg-[var(--color-danger)]
                hover:text-white
                transition-colors duration-200">
      Delete Selected
    </a>
  </div>

  <%# Put this anywhere in the page, outside other forms %>
  <%= form_with url: bulk_destroy_admin_contacts_path, method: :delete,
        id: "bulk-delete-form", class: "hidden" do |form| %>
    <div id="bulk-delete-ids"></div>
  <% end %>


  <%# Table Headers %>
  <% table_headers = capture do%>
    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Contact</th>
    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Phone</th>
    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Category</th>
    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Owner</th>
    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Added</th>
    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)] text-right">Actions</th>
  <%end%>

  <%= render "admin/shared/admin_table",headers: table_headers, show_checkboxes:true do %>
    <% @contacts.each do |contact|%>
  
     <tr class="hover:bg-gray-50 transition-colors duration-150">

        <td class="w-10 px-4 py-3">
          <input type="checkbox"
                class="contact-checkbox w-4 h-4 cursor-pointer
                accent-[var(--color-accent)]"
                value="<%= contact.id%>"
                data-action="change->export#toggle">
        </td>
        <%# Avatar + Name %>
        <td class="px-4 py-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[var(--color-accent-subtle)]
                        flex items-center justify-center
                        text-xs font-semibold text-[var(--color-accent)] shrink-0">
              <%= contact.firstname.first.upcase %>
            </div>
            <p class="text-xs font-semibold text-[var(--color-text-heading)]">
              <%= contact.firstname %> <%= contact.lastname %>
            </p>
          </div>
        </td>

        <%# Phone %>
        <td class="px-4 py-3 text-xs text-[var(--color-text-body)]">
          <%= contact.phone_number %>
        </td>

        <%# Category %>
        <td class="px-4 py-3">
          <% if contact.category.present? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full
                        text-xs font-medium bg-gray-100 text-gray-600">
              <%= contact.category %>
            </span>
          <% else %>
            <span class="text-xs text-[var(--color-text-muted)]">—</span>
          <% end %>
        </td>

        <%# Owner — links to admin user show (build next) %>
        <td class="px-4 py-3">
          <% if contact.user %>
            <div>
              <p class="text-xs font-medium text-[var(--color-text-heading)]">
                <%= contact.user.firstname %> <%= contact.user.lastname %>
              </p>
              <p class="text-xs text-[var(--color-text-muted)]">
                <%= contact.user.email %>
              </p>
            </div>
          <% else %>
            <span class="text-xs text-[var(--color-text-muted)]">—</span>
          <% end %>
        </td>

        <%# Added %>
        <td class="px-4 py-3 text-xs text-[var(--color-text-muted)]">
          <%= contact.created_at.strftime("%b %d, %Y") %>
        </td>

        <%# Actions %>
        <td class="px-4 py-3">
          <div class="flex items-center justify-end gap-3">
            <%= link_to "Edit", edit_admin_contact_path(contact),
                  class: "text-xs font-medium
                          text-[var(--color-text-muted)]
                          hover:text-[var(--color-text-heading)]
                          transition-colors duration-200" %>
            <%= link_to "Delete", admin_contact_path(contact),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Delete #{contact.firstname} #{contact.lastname}? This cannot be undone."
                  },
                  class: "text-xs font-medium
                          text-[var(--color-danger)]
                          hover:text-[var(--color-danger-hover)]
                          transition-colors duration-200" %>
          </div>
        </td>

      </tr>
    <% end %>
  <% end %>

  <%# Footer — per-page + pagination %>
  <div class="flex items-center justify-between">
    <p class="text-xs text-[var(--color-text-muted)]">
      Showing <%= @contacts.count %> of <%= @contacts.total_count %> contacts
    </p>

    <div class="flex items-center gap-4">

      <%# Per-page selector %>
     <%= form_with url:admin_contacts_path, method: :get, local:true do |form|%>
        <%= form.hidden_field :search, value: params[:search]%>
        <%= form.hidden_field :page, value:1 %>
        <label class="text-xs text-[var(--color-text-muted)]"> Show</label>
        <%= form.number_field :per_page,
            value: @per_page,
            min: 1,
            max: 50,
            #onchange: "this.form.submit()",
            class:"w-16 px-2 py-1 text-xs text-center
                  bg-[var(--color-input-bg)]
                  text-[var(--color-text-heading)]
                  border border-[var(--color-border-subtle)]
                  rounded-[var(--radius-md)]
                  focus:outline-none focus:ring-2 focus:ring-[var(--color-input-focus)]"%>
        <label class="text-sm text-[var(--color-text-muted)]">per page</label>

        <%= form.submit "Go",
             class:"px-3 py-1.5 text-xs font-medium
                    bg-surface-muted text-[var(--color-text-white)]]
                    rounded-[var(--radius-md)]
                    cursor-pointer
                    hover:bg-[var(--color-accent-hover)]
                    transition-colors duration-200"%>

      <%end%>

      <%# Prev / Next %>
      <% if @contacts.total_pages >= 1 %>
        <div class="flex items-center gap-2">
          <%= link_to "← Prev",
                admin_contacts_path(page: @contacts.prev_page, search: params[:search]),
                class: "px-3 py-1.5 text-xs font-medium
                        border border-[var(--color-border-subtle)]
                        rounded-[var(--radius-md)]
                        text-[var(--color-text-muted)]
                        hover:text-[var(--color-text-heading)]
                        #{'opacity-40 pointer-events-none' unless @contacts.prev_page}" %>
          <span class="text-xs text-[var(--color-text-muted)]">
            <%= @contacts.current_page %> / <%= @contacts.total_pages %>
          </span>
          <%= link_to "Next →",
                admin_contacts_path(page: @contacts.next_page, search: params[:search]),
                class: "px-3 py-1.5 text-xs font-medium
                        border border-[var(--color-border-subtle)]
                        rounded-[var(--radius-md)]
                        text-[var(--color-text-muted)]
                        hover:text-[var(--color-text-heading)]
                        #{'opacity-40 pointer-events-none' unless @contacts.next_page}" %>
        </div>
      <% end %>

    </div>
  </div>

</div>