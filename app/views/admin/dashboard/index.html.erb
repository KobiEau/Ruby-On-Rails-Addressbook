<% content_for :page_title, "Dashboard"%>
  <%# Stat Cards%>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-md)]
                shadow-[var(--shadow-card)] border border-[var(--color-border-subtle)]
                 p-4">
      <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider mb-1">
       Total Users </p>
      <p class="text-2xl font-bold text-[var(--color-text-heading)]"><%=@total_users%></p>
    </div>

    <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-md)]
                shadow-[var(--shadow-card)]
                border border-[var(--color-border-subtle)] p-4">
      <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider mb-1">
       Total Contacts </p>
      <p class="text-2xl font-bold text-[var(--color-text-heading)]"><%=@total_contacts%></p>
    </div>
    
    <div class="bg-[var(--color-surface-card)] rounded-[var(--radius-md)]
                shadow-[var(--shadow-card)]
                border border-[var(--color-border-subtle)] p-4">
      <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider mb-1">
       Admins </p>
      <p class="text-2xl font-bold text-[var(--color-text-heading)]"><%=@total_admins%></p>
    </div>

  </div>

<%# Recent Signups %>
    <h2 class="text-sm font-semibold text-[var(--color-text-heading)] mb-3">
      Recent Signups 
    </h2>
    
  <div class="bg-[var(--color-surface-card)] border border-[var(--color-border-subtle)]
              rounded-[var(--radius-lg)] shadow-[var(--shadow-card)]
              overflow-hidden px-2 py-3">
    <div class="overflow-y-auto max-h-[400px]">
      <table class="w-full">
        <thead class="bg-gray-50 border-b border-[var(--color-border-subtle)]">
          <tr class="text-left text-xs">
            <th class=" px-4 py-3 text-[var(--color-text-muted)] font-semibold uppercase tracking-wide">Name</th>
            <th class=" px-4 py-3 text-[var(--color-text-muted)] font-semibold uppercase tracking-wide">Email</th>
            <th class=" px-4 py-3 text-[var(--color-text-muted)] font-semibold uppercase tracking-wide">Role</th>
            <th class=" px-4 py-3 text-[var(--color-text-muted)] font-semibold uppercase tracking-wide">Joined</th>
            <th class=" px-4 py-3 text-[var(--color-text-muted)] font-semibold uppercase tracking-wide">Contacts</th>
            <th class=" px-4 py-3 text-[var(--color-text-muted)] font-semibold uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--color-border-subtle)] text-xs">
          <% @recent_users.each do |user|%>
            <tr class="border-b border-[var(--color-divider)] last:border-0
                      hover:bg-[var(--color-accent-subtle)]  transition-colors duration-150
                      hover:text-[var(--color-text-white)]">
              <td class="text-xs font-semibold text-[var(--color-text-heading)]">
                <%= user.fullname%> 
              </td>
              <td class="px-4 py-3 text-xs text-[var(--color-text-body)]">
              <%=user.email%>
              </td>
              <td class="px-4 py-3">
                <%if user.admin?%>
                  <span class="inline-flex items-center px-2 py-0.5
                              rounded-full text-xs font-medium
                              bg-[var(--color-accent-subtle)]
                              text-[var(--color-accent)]">
                    Admin
                  </span>
                <%else%>
                  <span class="inline-flex items-center px-2 py-0.5
                              rounded-full text-xs font-medium
                              bg-gray-100 text-gray-600">
                    User
                  </span>
                <%end%>
              </td>
              <td class="px-4 py-3 text-[var(--color-text-body)]">
                <%= time_ago_in_words(user.created_at)%> ago
              </td>
              <td class="px-4 py-3 text-[var(--color-text-body)]">
                <%= user.contacts.count%>
              </td>
              <td class="px-4 py-3">
                <%= link_to "View", admin_user_path(user),
                    class:"text-[var(--color-accent)]
                          hover:text-[var(--color-accent-hover)]
                          font-medium transition-colors duration-150"%>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-3 pt-3 border-t border-[var(--color-divider)]">
      <%= link_to "View all users", admin_users_path,
          class: "text-xs text-[var(--color-accent)]
                  hover:text-[var(--color-accent-hover)]
                  font-medium transition-colors duration-150"%>
    </div>
  </div>