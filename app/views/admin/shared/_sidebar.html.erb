<div>
<aside class="w-42 min-h-screen  bg-[var(--color-surface-raised)]
              border-r border-[var(--color-border)] 
              flex flex-col justify-between py-4 px-3 sticky top-0 z-20">

  <%# Logo %>
  <div>
    <div class="mb-6 px-2">
      <span class="text-base font-bold text-[var(--color-text-base)]">
        <span class="text-[var(--color-accent)]">A</span>ddressbook
      </span>
      <p class="text-xs text-[var(--color-text-muted)] mt-0.5">Admin Panel</p>
    </div>

    <%# Nav links %>
    <nav class="flex flex-col gap-1">

      <%= link_to admin_root_path,
            class: "flex items-center gap-2 px-2 py-1.5 rounded-[var(--radius-sm)] text-xs
                    transition-colors duration-200
                    #{request.path == admin_root_path ?
                      'bg-[var(--color-surface-muted)] text-[var(--color-accent)] font-semibold' :
                      'text-[var(--color-text-muted)] hover:text-[var(--color-text-base)] hover:bg-[var(--color-surface-muted)]'}" do %>
        <svg class="w-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Dashboard
      <% end %>

      <%= link_to admin_users_path,
            class: "flex items-center gap-2 px-2 py-1.5 rounded-[var(--radius-sm)] text-xs
                    transition-colors duration-200
                    #{request.path.start_with?('/admin/users') ?
                      'bg-[var(--color-surface-muted)] text-[var(--color-accent)] font-semibold' :
                      'text-[var(--color-text-muted)] hover:text-[var(--color-text-base)] hover:bg-[var(--color-surface-muted)]'}" do %>
        <svg class="w-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Users
      <% end %>

      <%= link_to admin_contacts_path,
            class: "flex items-center gap-2 px-2 py-1.5 rounded-[var(--radius-sm)] text-xs
                    transition-colors duration-200
                    #{request.path.start_with?('/admin/contacts') ?
                      'bg-[var(--color-surface-muted)] text-[var(--color-accent)] font-semibold' :
                      'text-[var(--color-text-muted)] hover:text-[var(--color-text-base)] hover:bg-[var(--color-surface-muted)]'}" do %>
        <svg class="w-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Contacts
      <% end %>


      <%= link_to edit_user_registration_path,
            class: "flex items-center gap-2 px-2 py-1.5 rounded-[var(--radius-sm)] text-xs
                    transition-colors duration-200
                    #{request.path.start_with?('/users/contacts') ?
                      'bg-[var(--color-surface-muted)] text-[var(--color-accent)] font-semibold' :
                      'text-[var(--color-text-muted)] hover:text-[var(--color-text-base)] hover:bg-[var(--color-surface-muted)]'}" do %>
        <svg class="w-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        My Account
      <% end %>

    </nav>
  </div>

  <%# Bottom — back to app %>
  <div class="px-2 border-t border-[var(--color-border)] pt-3">
    <%= link_to contacts_path,
          class: "flex items-center gap-2 text-xs
                  text-[var(--color-text-muted)]
                  hover:text-[var(--color-accent)]
                  transition-colors duration-200" do %>
      <svg class="w-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to App
    <% end %>
  </div>

</aside>


</div>