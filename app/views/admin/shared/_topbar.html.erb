<div class="w-full bg-[var(--color-surface-raised)] border-b border-[var(--color-border)] sticky top-0 z-40 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 lg:py-0">
    
    <%# Container: Stacks vertically on mobile, single row on desktop %>
    <div class="flex flex-col lg:flex-row lg:h-16 lg:items-center lg:justify-between gap-2 lg:gap-6">
      
      <%# LEFT GROUP: Branding & Global Links %>
      <div class="flex items-center justify-between lg:justify-start gap-6 border-b lg:border-b-0 border-[var(--color-border-subtle)] pb-2 lg:pb-0">
        <%= link_to admin_root_path do%>
          <div class="flex flex-col">
            <span class="text-base font-bold text-[var(--color-text-base)] tracking-tight">
              <span class="text-[var(--color-accent)]">A</span>ddressbook
            </span>
            <span class="text-[10px] text-[var(--color-text-muted)] uppercase tracking-widest font-semibold -mt-1">
              Admin Panel
            </span>
          </div>
        <% end %>
        <nav class="flex items-center gap-1 sm:gap-2">
          <%= link_to "Dashboard", admin_root_path, 
                class: "px-2 py-1 rounded-[var(--radius-sm)] text-xs font-medium transition-colors 
                #{request.path == admin_root_path ? 'bg-[var(--color-surface-muted)] text-[var(--color-accent)] font-semibold' 
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-base)]'}" %>
          <%= link_to "Users", admin_users_path, 
                class: "px-2 py-1 rounded-[var(--radius-sm)] text-xs font-medium transition-colors #{request.path.start_with?('/admin/users') ? 
                'bg-[var(--color-surface-muted)] text-[var(--color-accent)] font-semibold' 
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-base)]'}" %>
          <%= link_to "Contact", admin_contacts_path, 
                class: "px-2 py-1 rounded-[var(--radius-sm)] text-xs font-medium transition-colors #{request.path.start_with?('/admin/contacts') ? 
                'bg-[var(--color-surface-muted)] text-[var(--color-accent)] font-semibold'
                 : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-base)]'}" %>
          <%= link_to "Errors", admin_error_logs_path, 
                class: "px-2 py-1 rounded-[var(--radius-sm)] text-xs font-medium transition-colors #{request.path.start_with?('/admin/error') ? 
                'bg-[var(--color-surface-muted)] text-[var(--color-accent)] font-semibold'
                 : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-base)]'}" %>
        </nav>
      </div>

      <%# RIGHT GROUP: Page Title & Account Utilities %>
      <div class="flex items-center justify-between lg:justify-end gap-6 flex-1">
        <%# Dynamic Page Title %>
        <h1 class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">
          <%= content_for?(:page_title) ? yield(:page_title) : "Admin" %>
        </h1>

        <%# Profile & Session Controls %>
        <div class="flex items-center gap-4 text-xs">
          <%= link_to contacts_path, class: "flex items-center gap-1 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            App View
          <% end %>

          <span class="text-[var(--color-text-muted)] font-medium hidden sm:inline">
            <%= current_user.firstname %> <%= current_user.lastname %>
          </span>

          <%= link_to "Sign Out", destroy_user_session_path, 
                data: { turbo_method: :delete }, 
                class: "font-medium text-[var(--color-text-muted)] hover:text-[var(--color-danger)] transition-colors" %>
        </div>
      </div>

    </div>

  </div>
</div>