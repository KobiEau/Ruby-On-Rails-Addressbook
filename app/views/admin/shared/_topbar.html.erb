<header class="h-10 bg-[var(--color-surface-raised)]
               border-b border-[var(--color-border)]
               flex items-center justify-between px-6">

  <%# Page title — pulled from content_for in each view %>
  <%# <h1 class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">
    <%= content_for?(:page_title) ? yield(:page_title) : "Admin" </h1>%> 

    <div class="text-l font-semibold text-white">
      <%= current_user.firstname %> <%= current_user.lastname %>
    </div>
  <%# Signed in admin %>
  <div class="flex items-center gap-3">
    <%= link_to "Sign Out", destroy_user_session_path,
          data: { turbo_method: :delete },
          class: "text-m text-[var(--color-text-muted)]
                  hover:text-[var(--color-danger)]
                  transition-colors duration-200" %>
  </div>

</header>