<%= form_with model: [:admin, user], class: "space-y-4" do |f| %>

  <%= render "shared/error_block", record: user %>

  <div class="w-full
              bg-[var(--color-surface-card)]
              border border-[var(--color-border-subtle)]
              rounded-[var(--radius-lg)]
              shadow-[var(--shadow-card)]
              p-5">

    <!-- Header -->
    <%# <div class="mb-4">
      <h2 class="text-lg font-semibold text-[var(--color-text-heading)]">
        User Information
      </h2>

      <p class="text-sm text-[var(--color-text-muted)] mt-1">
        Create and manage user account details.
      </p>
    </div> %>

    <!-- Responsive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">

      <!-- First Name -->
      <div>
        <%= f.label :firstname,
              class: "block mb-1.5
                      text-sm font-medium
                      text-[var(--color-text-heading)]" %>

        <%= f.text_field :firstname,
              class: "w-full
                      rounded-[var(--radius-md)]
                      border border-[var(--color-border-subtle)]
                      bg-[var(--color-surface-base)]
                      px-3 py-2
                      text-sm
                      text-[var(--color-text-body)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent)]
                      focus:border-transparent" %>
      </div>

      <!-- Last Name -->
      <div>
        <%= f.label :lastname,
              class: "block mb-1.5
                      text-sm font-medium
                      text-[var(--color-text-heading)]" %>

        <%= f.text_field :lastname,
              class: "w-full
                      rounded-[var(--radius-md)]
                      border border-[var(--color-border-subtle)]
                      bg-[var(--color-surface-base)]
                      px-3 py-2
                      text-sm
                      text-[var(--color-text-body)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent)]
                      focus:border-transparent" %>
      </div>

      <!-- Role -->
      <div>
        <%= f.label :role_code,
              class: "block mb-1.5
                      text-sm font-medium
                      text-[var(--color-text-heading)]" %>

        <%= f.select :role_code,
              [["User", "usr"], ["Admin", "adm"]],
              {},
              class: "w-full
                      rounded-[var(--radius-md)]
                      border border-[var(--color-border-subtle)]
                      bg-[var(--color-surface-base)]
                      px-3 py-2
                      text-sm
                      text-[var(--color-text-body)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent)]
                      focus:border-transparent" %>
      </div>

      <!-- Email -->
      <div>
        <%= f.label :email,
              class: "block mb-1.5
                      text-sm font-medium
                      text-[var(--color-text-heading)]" %>

        <%= f.email_field :email,
              class: "w-full
                      rounded-[var(--radius-md)]
                      border border-[var(--color-border-subtle)]
                      bg-[var(--color-surface-base)]
                      px-3 py-2
                      text-sm
                      text-[var(--color-text-body)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent)]
                      focus:border-transparent" %>
      </div>

      <!-- Password -->
      <div>
        <%= f.label :password,
              class: "block mb-1.5
                      text-sm font-medium
                      text-[var(--color-text-heading)]" %>

        <%= f.password_field :password,
              class: "w-full
                      rounded-[var(--radius-md)]
                      border border-[var(--color-border-subtle)]
                      bg-[var(--color-surface-base)]
                      px-3 py-2
                      text-sm
                      text-[var(--color-text-body)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent)]
                      focus:border-transparent" %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <%= f.label :password_confirmation,
              class: "block mb-1.5
                      text-sm font-medium
                      text-[var(--color-text-heading)]" %>

        <%= f.password_field :password_confirmation,
              class: "w-full
                      rounded-[var(--radius-md)]
                      border border-[var(--color-border-subtle)]
                      bg-[var(--color-surface-base)]
                      px-3 py-2
                      text-sm
                      text-[var(--color-text-body)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent)]
                      focus:border-transparent" %>
      </div>

    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-3 mt-6">

      <%= link_to "Cancel",
            admin_users_path,
            class: "inline-flex items-center justify-center
                    px-4 py-2
                    rounded-[var(--radius-md)]
                    border border-[var(--color-border-subtle)]
                    bg-[var(--color-surface-base)]
                    text-sm font-medium
                    text-[var(--color-text-muted)]
                    hover:bg-[var(--color-surface-muted)]
                    transition-colors duration-200" %>

      <%= f.submit class: "inline-flex items-center justify-center
                          px-4 py-2
                          rounded-[var(--radius-md)]
                          bg-[var(--color-accent)]
                          text-white
                          text-sm font-medium
                          hover:bg-[var(--color-accent-hover)]
                          transition-colors duration-200" %>

    </div>

  </div>

<% end %>