
<div class="space-y-6 max-w-2xl">

  <!-- Form Card -->
  <div class="">
   
    <%= form_with model: [:admin, @user], local: true,
          class: "space-y-5" do |form| %>
      

      <%# Error messages %>
      <%= render "shared/error_block", record: @user%>

      <!-- First Name -->
      <div class="space-y-1.5">

        <%= form.label :firstname,
              class: "block text-sm font-medium text-[var(--color-text-heading)]" %>

        <%= form.text_field :firstname,
              class: "w-full px-3 py-2 text-sm
                      bg-[var(--color-surface-card)]
                      border border-[var(--color-border-subtle)]
                      rounded-[var(--radius-md)]
                      text-[var(--color-text-heading)]
                      placeholder:text-[var(--color-text-muted)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent-subtle)]
                      focus:border-[var(--color-accent)]" %>

      </div>

      <!-- Last Name -->
      <div class="space-y-1.5">

        <%= form.label :lastname,
              class: "block text-sm font-medium text-[var(--color-text-heading)]" %>

        <%= form.text_field :lastname,
              class: "w-full px-3 py-2 text-sm
                      bg-[var(--color-surface-card)]
                      border border-[var(--color-border-subtle)]
                      rounded-[var(--radius-md)]
                      text-[var(--color-text-heading)]
                      placeholder:text-[var(--color-text-muted)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent-subtle)]
                      focus:border-[var(--color-accent)]" %>

      </div>

      <!-- Email -->
      <div class="space-y-1.5">

        <%= form.label :email,
              class: "block text-sm font-medium text-[var(--color-text-heading)]" %>

        <%= form.email_field :email,
              class: "w-full px-3 py-2 text-sm
                      bg-[var(--color-surface-card)]
                      border border-[var(--color-border-subtle)]
                      rounded-[var(--radius-md)]
                      text-[var(--color-text-heading)]
                      placeholder:text-[var(--color-text-muted)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent-subtle)]
                      focus:border-[var(--color-accent)]" %>

      </div>

      <!-- Password -->
      <div class="space-y-1.5">

        <%= form.label :password,
              class: "block text-sm font-medium text-[var(--color-text-heading)]" %>

        <%= form.password_field :password,
              class: "w-full px-3 py-2 text-sm
                      bg-[var(--color-surface-card)]
                      border border-[var(--color-border-subtle)]
                      rounded-[var(--radius-md)]
                      text-[var(--color-text-heading)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent-subtle)]
                      focus:border-[var(--color-accent)]" %>

      </div>

      <!-- Password Confirmation -->
      <div class="space-y-1.5">

        <%= form.label :password_confirmation,
              class: "block text-sm font-medium text-[var(--color-text-heading)]" %>

        <%= form.password_field :password_confirmation,
              class: "w-full px-3 py-2 text-sm
                      bg-[var(--color-surface-card)]
                      border border-[var(--color-border-subtle)]
                      rounded-[var(--radius-md)]
                      text-[var(--color-text-heading)]
                      focus:outline-none
                      focus:ring-2
                      focus:ring-[var(--color-accent-subtle)]
                      focus:border-[var(--color-accent)]" %>

      </div>

      <!-- Account Type -->
      <div class="space-y-3">

        <div>
          <h2 class="text-sm font-medium text-[var(--color-text-heading)]">
            Account Type
          </h2>

          <p class="text-xs text-[var(--color-text-muted)] mt-1">
            Choose the permissions this account should have.
          </p>
        </div>

        <div class="space-y-3">

          <!-- Regular User -->
          <label class="flex items-start gap-3
                        border border-[var(--color-border-subtle)]
                        rounded-[var(--radius-md)]
                        p-4
                        cursor-pointer
                        hover:border-[var(--color-accent)] transition-colors">

            <%= form.radio_button :role_code, "usr",
                  checked: true,
                  class: "mt-1 text-[var(--color-accent)]
                          focus:ring-[var(--color-accent)]" %>

            <div>
              <p class="text-sm font-medium text-[var(--color-text-heading)]">
                Regular User
              </p>

              <p class="text-xs text-[var(--color-text-muted)] mt-1">
                Can manage personal contacts only.
              </p>
            </div>

          </label>

          <!-- Admin -->
          <label class="flex items-start gap-3
                        border border-[var(--color-border-subtle)]
                        rounded-[var(--radius-md)]
                        p-4
                        cursor-pointer
                        hover:border-[var(--color-accent)] transition-colors">

            <%= form.radio_button :role_code, "adm",
                  class: "mt-1 text-[var(--color-accent)]
                          focus:ring-[var(--color-accent)]" %>

            <div>
              <p class="text-sm font-medium text-[var(--color-text-heading)]">
                Administrator
              </p>

              <p class="text-xs text-[var(--color-text-muted)] mt-1">
                Full access to users, contacts, and admin tools.
              </p>
            </div>

          </label>

        </div>

      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3 pt-2">

        <%= form.submit "Create User",
              class: "px-4 py-2 text-sm font-semibold
                      bg-[var(--color-accent)]
                      hover:bg-[var(--color-accent-hover)]
                      text-[var(--color-text-on-accent)]
                      rounded-[var(--radius-md)]
                      shadow-[var(--shadow-btn)]
                      transition-colors duration-200
                      cursor-pointer" %>

        <%= link_to "Cancel", admin_users_path,
              class: "text-sm text-[var(--color-text-muted)]
                      hover:text-[var(--color-text-heading)]
                      transition-colors duration-200" %>

      </div>

    <% end %>

  </div>

</div>
```
