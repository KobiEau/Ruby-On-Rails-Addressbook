<% content_for :page_title, "Users" %>

<div class="space-y-4">

  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-[var(--color-text-heading)]">
        Users
      </h1>
      <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
        <%= @users.total_count %> registered users
        <%# total_count — Kaminari method, gives total across ALL pages %>
        <%# not just the current page %>
      </p>
    </div>
  </div>

  <%# Toolbar %>
  <div class="flex items-center justify-between gap-3">

    <%# Search + Filter %>
    <%= form_with url: admin_users_path, method: :get, local: true,
          class: "flex items-center gap-3" do |form| %>

      <%= form.text_field :search,
            value: params[:search],
            placeholder: "Search users...",
            class: "w-64 px-3 py-1.5 text-xs
                    bg-[var(--color-surface-card)]
                    border border-[var(--color-border-subtle)]
                    rounded-[var(--radius-md)]
                    text-[var(--color-text-heading)]
                    placeholder:text-[var(--color-text-muted)]
                    focus:outline-none
                    focus:ring-1 focus:ring-[var(--color-accent)]
                    focus:border-[var(--color-accent)]" %>
      <%# form_with + method: :get means submitting this form
          adds ?search=... to the URL — controller reads params[:search] %>

      <%= form.select :role_filter,
            [["All Roles", ""], ["Admins", "adm"], ["Users", "usr"]],
            { selected: params[:role_filter] },
            class: "px-3 py-1.5 text-xs
                    bg-[var(--color-surface-card)]
                    border border-[var(--color-border-subtle)]
                    rounded-[var(--radius-md)]
                    text-[var(--color-text-heading)]
                    focus:outline-none
                    focus:ring-1 focus:ring-[var(--color-accent)]" %>

      <%= form.submit "Search",
            class: "px-3 py-1.5 text-xs font-medium
                    bg-surface-muted text-[var(--color-text-white)]]
                    rounded-[var(--radius-md)]
                    cursor-pointer
                    hover:bg-[var(--color-accent-hover)]
                    transition-colors duration-200" %>

      <% if params[:search].present? || params[:role_filter].present? %>
        <%= link_to "✕ Clear", admin_users_path,
              class: "text-xs text-[var(--color-text-muted)]
                      hover:text-[var(--color-danger)]
                      transition-colors duration-200" %>
      <% end %>

    <% end %>

    <%# New User Btn %>
    <%= link_to "+ New User",new_admin_user_path,
        class:"px-3 py-1.5 text-sm font-bold 
              bg-[var(--color-accent)] hover:[var(--bg-accent-hover)]
              text-text-on-accent rounded-[var(--radius-md)]
              shadow-[var(--shadow-btn)] transition duration-200" %> 
        
  </div>

  <%# Table %>
  <div class="bg-[var(--color-surface-card)] border border-[var(--color-border-subtle)]
              rounded-[var(--radius-lg)] shadow-[var(--shadow-card)]
              overflow-hidden">

    <table class="w-full">

      <%# Header %>
      <thead class="bg-gray-50 border-b border-[var(--color-border-subtle)]">
        <tr class="text-left">
          <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide
                     text-[var(--color-text-muted)]">Name</th>
          <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide
                     text-[var(--color-text-muted)]">Email</th>
          <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide
                     text-[var(--color-text-muted)]">Role</th>
          <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide
                     text-[var(--color-text-muted)]">Contacts</th>
          <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide
                     text-[var(--color-text-muted)]">Joined</th>
          <th class="text-right px-4 py-3 text-xs font-semibold uppercase tracking-wide
                    text-[var(--color-text-muted)]">Actions</th>
        </tr>
      </thead>

      <%# Body %>
      <tbody class="divide-y divide-[var(--color-divider)]">
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50 transition-colors duration-150">

            <%# Avatar + Name %>
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full
                            bg-[var(--color-accent-subtle)]
                            flex items-center justify-center
                            text-xs font-semibold
                            text-[var(--color-accent)] shrink-0">
                  <%= user.firstname.first.upcase %>
                </div>
                <div>
                  <p class="text-xs font-semibold text-[var(--color-text-heading)]">
                    <%= user.fullname %>
                  </p>
                </div>
              </div>
            </td>

            <%# Email %>
            <td class="px-4 py-3 text-xs text-[var(--color-text-body)]">
              <%= user.email %>
            </td>

            <%# Role Badge %>
            <td class="px-4 py-3">
              <% if user.admin? %>
                <span class="inline-flex items-center px-2 py-0.5
                             rounded-full text-xs font-medium
                             bg-[var(--color-accent-subtle)]
                             text-[var(--color-accent)]">
                  Admin
                </span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5
                             rounded-full text-xs font-medium
                             bg-gray-100 text-gray-600">
                  User
                </span>
              <% end %>
            </td>

            <%# Contacts Count %>
            <td class="px-4 py-3 text-xs text-[var(--color-text-body)]">
              <%= user.contacts.count %>
              <%# Safe — contacts preloaded via includes(:contacts) in controller %>
            </td>

            <%# Joined %>
            <td class="px-4 py-3 text-xs text-[var(--color-text-muted)]">
              <%= user.created_at.strftime("%b %d, %Y") %>
              <%# strftime formats the timestamp — "%b %d, %Y" → "May 05, 2026" %>
            </td>

            <%# Actions %>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-3">
                <%= link_to "View", admin_user_path(user),
                      class: "text-xs font-medium
                              text-[var(--color-accent)]
                              hover:text-[var(--color-accent-hover)]
                              transition-colors duration-200" %>
                <%= link_to "Edit", edit_admin_user_path(user),
                      class: "text-xs font-medium
                              text-[var(--color-text-muted)]
                              hover:text-[var(--color-text-heading)]
                              transition-colors duration-200" %>
                <%= link_to "Delete", admin_user_path(user),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Delete #{user.fullname}? This also deletes all their contacts."
                      },
                      class: "text-xs font-medium
                              text-[var(--color-danger)]
                              hover:text-[var(--color-danger-hover)]
                              transition-colors duration-200" %>
              </div>
            </td>

          </tr>
        <% end %>

        <%# Empty state %>
        <% if @users.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-xs text-[var(--color-text-muted)]">
              No users found.
            </td>
          </tr>
        <% end %>

      </tbody>
    </table>
  </div>

  <%# Footer — count + pagination %>
  <div class="flex items-center justify-between">
    <p class="text-xs text-[var(--color-text-muted)]">
      Showing <%= @users.count %> of <%= @users.total_count %> users
    </p>
    <% if @users.total_pages >= 1 %>

      <%= form_with url:admin_users_path, method: :get, local:true do |form|%>
        <%= form.hidden_field :search, value: params[:search]%>
        <%= form.hidden_field :page, value:1 %>
        <label class="text-xs text-[var(--color-text-muted)]"> Show</label>
        <%= form.number_field :per_page,
            value: @per_page,
            min: 1,
            max: 50,
            #onchange: "this.form.submit()",
            class:"w-16 px-2 py-1 text-xs text-center
                  bg-[var(--color-input-bg)]
                  text-[var(--color-text-heading)]
                  border border-[var(--color-border-subtle)]
                  rounded-[var(--radius-md)]
                  focus:outline-none focus:ring-2 focus:ring-[var(--color-input-focus)]"%>
        <label class="text-sm text-[var(--color-text-muted)]">per page</label>

        <%= form.submit "Go",
             class:"px-3 py-1.5 text-xs font-medium
                    bg-surface-muted text-[var(--color-text-white)]]
                    rounded-[var(--radius-md)]
                    cursor-pointer
                    hover:bg-[var(--color-accent-hover)]
                    transition-colors duration-200"%>

      <%end%>
      <div class="flex items-center gap-2">
        <%= link_to "← Prev", admin_users_path(page: @users.prev_page, search: params[:search], role_filter: params[:role_filter],per_page: @per_page),
              class: "px-3 py-1.5 text-xs font-medium
                      border border-[var(--color-border-subtle)]
                      rounded-[var(--radius-md)]
                      text-[var(--color-text-muted)]
                      hover:text-[var(--color-text-heading)]
                      #{'opacity-40 pointer-events-none' unless @users.prev_page}" %>
        <span class="text-xs text-[var(--color-text-muted)]">
          <%= @users.current_page %> / <%= @users.total_pages %>
        </span>
        <%= link_to "Next →", admin_users_path(page: @users.next_page, search: params[:search], role_filter: params[:role_filter],per_page: @per_page),
              class: "px-3 py-1.5 text-xs font-medium
                      border border-[var(--color-border-subtle)]
                      rounded-[var(--radius-md)]
                      text-[var(--color-text-muted)]
                      hover:text-[var(--color-text-heading)]
                      #{'opacity-40 pointer-events-none' unless @users.next_page}" %>
      </div>
    <% end %>
  </div>

</div>