<turbo-frame id="user-detail">
  <div class="p-6 space-y-4">
    <%# Header & Close button %>
    <div class="flex items-center justify-between sticky top-0 z-10 bg-[var(--color-surface-card)]">
      <h2 class="text-sm font-bold text-[var(--color-text-heading)]">
        User Details
      </h2>
      <button data-action="click->split-pane#close"
          type="button"
          class="text-sm text-[var(--color-text-muted)]
                hover:text-[var(--color-danger)]
                transition-colors duration-200" >
       X Close
      </button>    
    </div>

    <%# Avatar + Name %>
    <div class="flex items-center gap-3 sticky top-10 z-10 bg-[var(--color-surface-card)]">
      <%= render "shared/contact_avatar", record:@user %>
    </div>

    <%# Divider %>
    <hr class="border-[var(--color-divider)]">

    <%# Details %>
      <dl class="space-y-3">
        <div>
          <dt class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">
            Role
          </dt>
          <dd class="mt-1">
            <% if @user.admin? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full
                          text-xs font-medium
                          bg-[var(--color-accent-subtle)] text-[var(--color-accent)]">
                Admin
              </span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full
                          text-xs font-medium bg-gray-100 text-gray-600">
                User
              </span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">
            Status
          </dt>
          <dd class="mt-1 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full <%= @user.active? ? 'bg-green-400' : 'bg-red-400'%> "></span>
            <span class="text-xs text-[var(--color-text-heading)]"> <%= @user.active? ? 'Active' : 'Locked'%>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">
            Contacts
          </dt>
          <dd class="text-sm text-[var(--color-text-heading)] mt-1">
            <%= @user.contacts.count %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">
            Activity (5 days)
          </dt>
          <dd class="text-sm text-[var(--color-text-heading)] mt-1">
            <%= @user.recent_contacts_count %> contacts added
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">
            Joined
          </dt>
          <dd class="text-sm text-[var(--color-text-heading)] mt-1">
            <%= @user.created_at.strftime("%b %d, %Y") %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">
            Updated
          </dt>
          <dd class="text-sm text-[var(--color-text-heading)] mt-1">
            <%= @user.updated_at.strftime("%b %d, %Y") %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide"> Sign-ins</dt>
          <dd class="text-sm text-[var(--color-text-heading)] mt-1">
            <%= @user.sign_in_count %> total 
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide"> Last seen</dt>
          <dd class="text-sm text-[var(--color-text-heading)] mt-1">
            <%= @user.last_sign_in_at&.strftime("%b %d, %Y %H:%M") || "Never" %>
          </dd>
        </div>
      </dl>

    <div class="space-y-2">
  <h3 class="text-xs font-bold text-[var(--color-text-heading)] uppercase tracking-wider">
    Owned Contacts (<%= @user.contacts.count %>)
  </h3>

  <%# The scrollable box container %>
  <div class="space-y-1.5 max-h-48 overflow-y-auto ">
    <% if @user.contacts.any? %>
      <% @user.contacts.each do |contact| %>
        <div class="flex items-center justify-between p-2 rounded-[var(--radius-md)] 
                    bg-[var(--color-surface-card)] 
                    border border-[var(--color-border-subtle)] shadow-sm">
          <div class="flex items-center gap-2 overflow-hidden">
             <div class="flex items-center gap-3">
              <%= render "shared/contact_avatar_small", record: contact %>
            </div>
          </div>
          
          <%# View link that breaks out of the frame if you want to navigate away %>
          <%= link_to "View →", admin_contact_path(contact), data: { turbo_frame: "_top" }, class: "text-[10px] font-semibold text-[var(--color-accent)] hover:underline" %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-6 text-[var(--color-text-muted)] text-xs">
        No contacts linked to this account yet.
      </div>
    <% end %>
  </div>
</div>
    <%# Divider %>
      <% unless @user == current_user%>
    <hr class="border-[var(--color-divider)]">
        <%= form_with model: [:admin, @user], method: :patch,
            data:{turbo_frame: "_top"} do |form|%>
            <%= form.select :role_code,
                [["User","usr"],["Admin","adm"]],
                {selected: @user.role_code},
                onchange:"if(confirm('Change role for #{@user.fullname}?')){
                          this.form.submit()
                        }else {
                          this.value = '#{@user.role_code}'
                        }",
                class:"px-2 py-1 text-xs bg-[var(--color-input-bg)]
                      text-[var(--color-text-heading)]
                      border border-[var(--color-border-subtle)]
                      rounded-[var(--radius-md)] focus:outline-none
                      focus:ring-1 focus:ring-[var(--color-accent)]"%>
          <% end %>
      <% end%>

      <% unless @user == current_user %>
        <%# Divider %>
        <hr class="border-[var(--color-divider)]">
        <div>
            <% if @user.active? %>
              <%= link_to "Lock Account", lock_admin_user_path(@user),
                  data:{
                    turbo_method: :patch,
                    turbo_confirm: "Lock #{@user.fullname}? They won't be able to sign-in"
                  },
                  class:"px-3 py-1.5 text-xs font-medium
                        text-[var(--color-danger)]
                        border border-[var(--color-danger)]
                        hover:bg-[var(--color-danger)] hover:text-white
                        rounded-[var(--radius-md)]
                        transition-colors duration-200" %>
            <% else %>
              <%= link_to "Unlock Account", unlock_admin_user_path(@user),
                  data:{
                    turbo_method: :patch},
                  class:"px-3 py-1.5 text-xs font-medium
                        text-[var(--color-success)]
                        border border-[var(--color-success)]
                        hover:bg-[var(--color-success)] hover:text-white
                        rounded-[var(--radius-md)]
                        transition-colors duration-200" %>
            <% end %>
        </div>
      <% end %>
    <%# Divider %>
    <hr class="border-[var(--color-divider)]">

    <%# Actions %>
      <div class="flex items-center gap-3 pt-2">
        <%= link_to "Edit", edit_admin_user_path(@user),
            data:{turbo_frame:"_top"},
            class: "px-3 py-1.5 text-xs font-medium
                    bg-[var(--color-btn-secondary)]
                    hover:bg-[var(--color-btn-secondary-hover)]
                    text-white rounded-[var(--radius-md)]
                    transition-colors duration-200" %>
        <% unless @user == current_user%>
          <%= link_to "Delete", admin_user_path(@user),
                data:{
                  turbo_method: :delete,
                  turbo_confirm: "Delete #{@user.fullname}? This also deletes all their contacts."
                },
                class:"px-3 py-1.5 text-xs font-medium 
                      text-[var(--color-danger)]
                      border border-[var(--color-danger)]
                      hover:bg-[var(--color-danger)] hover:text-white
                      rounded-[var(--radius-md)] transition-colors duration-200"
                %>
        <% end %>
      </div>

  </div>
</turbo-frame>