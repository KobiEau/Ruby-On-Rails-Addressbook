<div class="min-h-screen px-4 py-[var(--spacing-8)]">
  <div class="max-w-lg mx-auto">

    <%= render "shared/back_link",
          text: "← Back to Account",
          path: account_path %>

    <div class="mb-[var(--spacing-6)]">
      <h1 class="text-xl font-bold ext-[var(--color-text-muted)]">
        Import Contacts
      </h1>
      <p class="text-sm text-[var(--color-text-muted)] mt-1">
        Upload a CSV file to add contacts to your addressbook
      </p>
    </div>

   

    <%# ── Format instructions card ── %>
    <div class="bg-[var(--color-surface-card)]
                rounded-[var(--radius-lg)]
                shadow-[var(--shadow-card)]
                px-[var(--spacing-8)] py-[var(--spacing-6)]
                mb-[var(--spacing-6)]">

      <h2 class="text-sm font-bold text-[var(--color-text-heading)]
                 mb-[var(--spacing-4)]">
        Required CSV format
      </h2>

      <%# Show the user exactly what the CSV should look like %>
      <div class="bg-[var(--color-surface)]
                  rounded-[var(--radius-md)]
                  px-[var(--spacing-4)] py-[var(--spacing-3)]
                  mb-[var(--spacing-4)]
                  font-mono text-sm text-[var(--color-text-muted)]">
        <p class="m-0">First Name,Last Name,Phone Number</p>
        <p class="m-0">Ama,Mensah,0244123456</p>
        <p class="m-0">Kwame,Owusu,0201987654</p>
      </div>

      <ul class="text-sm text-[var(--color-text-body)] space-y-1 list-disc ml-5">
        <li>First row must be the header row exactly as shown</li>
        <li>Column order does not matter as long as headers match</li>
        <li>Phone numbers must be 10 digits starting with 02, 03 or 05</li>
        <li>Rows that fail validation are skipped and reported</li>
      </ul>

    </div>

    <%# ── Upload form card ── %>
    <div class="bg-[var(--color-surface-card)]
                rounded-[var(--radius-lg)]
                shadow-[var(--shadow-card)]
                px-[var(--spacing-8)] py-[var(--spacing-6)]">

      <h2 class="text-sm font-bold text-[var(--color-text-heading)]
                 mb-[var(--spacing-6)]">
        Upload file
      </h2>

      <%# multipart: true is required for file uploads —
          without it Rails only sends the filename, not the file contents %>
      <%= form_with url: import_create_contacts_path,
                    method: :post,
                    multipart: true,
                    local: true do |form| %>

        <div class="mb-[var(--spacing-6)]">
          <%= form.label :file, "Choose CSV file",
                class: "block text-sm font-semibold mb-[var(--spacing-2)]
                        text-[var(--color-label)]" %>

          <%= form.file_field :file,
                accept: ".csv",
                class: "w-full text-sm text-[var(--color-text-body)]
                        file:mr-4 file:py-2 file:px-4
                        file:rounded-[var(--radius-md)]
                        file:border-0
                        file:text-sm file:font-semibold
                        file:bg-[var(--color-surface-muted)]
                        file:text-[var(--color-text-base)]
                        file:cursor-pointer
                        hover:file:bg-[var(--color-btn-secondary-hover)]
                        cursor-pointer" %>

          <p class="mt-1 text-xs text-[var(--color-text-muted)]">
            .csv files only
          </p>
        </div>

        <div class="flex items-center gap-[var(--spacing-3)]">
          <%= form.submit "Import Contacts",
                class: "px-[var(--spacing-6)] py-[var(--spacing-3)]
                        bg-[var(--color-accent)]
                        hover:bg-[var(--color-accent-hover)]
                        text-[var(--color-text-on-accent)]
                        text-sm font-semibold
                        rounded-[var(--radius-md)]
                        shadow-[var(--shadow-btn)]
                        cursor-pointer
                        transition-colors duration-200" %>

          <%= link_to "Cancel",
                edit_user_registration_path,
                class: "px-[var(--spacing-6)] py-[var(--spacing-3)]
                        text-sm font-semibold
                        text-[var(--color-text-muted)]
                        hover:text-[var(--color-text-base)]
                        transition-colors duration-200" %>
        </div>

      <% end %>
    </div>

  </div>
</div>