<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            max-width: 480px;
            margin: 0 auto;
            padding: 40px 24px;
            background-color: #ffffff;">

  <%# ── Brand header ── %>
  <div style="margin-bottom: 32px;">
    <h1 style="font-size: 20px;
               font-weight: 800;
               color: #0f172a;
               margin: 0;">
      <span style="color: #34d399;">A</span>ddressbook
    </h1>
  </div>

  <%# ── Main content ── %>
  <div style="background-color: #f8fafc;
              border-radius: 12px;
              padding: 32px;
              margin-bottom: 24px;">

    <h2 style="font-size: 18px;
               font-weight: 700;
               color: #0f172a;
               margin: 0 0 12px 0;">
      Reset your password
    </h2>

    <%# @resource is the User object Devise passes to the mailer %>
    <p style="font-size: 14px;
              color: #475569;
              margin: 0 0 8px 0;">
      Hi <%= @resource.firstname.present? ? @resource.firstname : @resource.email %>,
    </p>

    <p style="font-size: 14px;
              color: #475569;
              margin: 0 0 24px 0;">
      Someone requested a password reset for your Addressbook account.
      Click the button below to choose a new password.
    </p>

    <%# ── CTA button ── %>
    <%# edit_password_url generates an absolute URL — required in emails
        because the user opens this in a browser, not inside the app.
        @token is the reset token Devise passes to the mailer. %>
    <div style="text-align: center; margin-bottom: 24px;">
      <%= link_to "Reset my password",
            edit_password_url(@resource, reset_password_token: @token),
            style: "display: inline-block;
                    background-color: #34d399;
                    color: #0f172a;
                    font-size: 14px;
                    font-weight: 700;
                    text-decoration: none;
                    padding: 12px 32px;
                    border-radius: 8px;" %>
    </div>

    <p style="font-size: 13px;
              color: #94a3b8;
              margin: 0;">
      This link expires in 6 hours. If you didn't request a password
      reset you can safely ignore this email — your password won't change until you access the link above and create a new one.
    </p>

  </div>

  <%# ── Footer ── %>
  <p style="font-size: 12px;
            color: #94a3b8;
            text-align: center;
            margin: 0;">
    Addressbook &mdash; your contacts, organised.
  </p>

</div>