<%# app/views/devise/registrations/new.html.erb %>

<div class="min-h-screen flex items-center justify-center
            bg-[var(--color-surface)]
            px-4 py-[var(--spacing-8)]">

  <div class="w-full max-w-md">

    <%# ── Logo / Brand ── %>
    <div class="text-center mb-[var(--spacing-6)]">
      <h1 class="text-2xl font-bold tracking-tight
                 text-[var(--color-text-base)]">
        <span class="text-[var(--color-accent)]">A</span>ddressbook
      </h1>
      <p class="mt-1 text-sm text-[var(--color-text-muted)]">
        Create your account
      </p>
    </div>

    <%# ── Card ── %>
    <div class="bg-[var(--color-surface-card)]
                rounded-[var(--radius-lg)]
                shadow-[var(--shadow-card)]
                px-[var(--spacing-8)] py-[var(--spacing-8)]">

      <%# ── Validation errors ── %>
      <%# resource here is the User object. If signup fails validation
          (e.g. email already taken, password too short), Devise populates
          resource.errors and re-renders this page.
          The shared/_error_block partial reads those errors and displays them. %>
      <%= render "shared/error_block",
            record: resource,
            message: "prevented your account from being created" %>

      <%# The sign up form %>
      <%# url: registration_path(resource_name) = POST /users (Devise's signup route) %>
      <%= form_for(resource,
                   as: resource_name,
                   url: registration_path(resource_name)) do |form| %>

        <%# ── Name row (side by side on wider screens) ── %>
        <div class="flex gap-[var(--spacing-3)] mb-[var(--spacing-4)]">

          <%# First name %>
          <div class="flex-1">
            <%= form.label :firstname, "First name",
                  class: "block text-sm font-semibold mb-[var(--spacing-2)]
                          text-[var(--color-label)]" %>
            <%= form.text_field :firstname,
                  autofocus: true,
                  autocomplete: "given-name",
                  placeholder: "Ama",
                  class: "w-full px-4 py-2 pr-10 text-sm
                  bg-[var(--color-input-bg)]
                  text-[var(--color-text-heading)]
                  border border-[var(--color-input-border)]
                  rounded-lg focus:outline-none 
                  focus:ring-2 focus:ring-[var(--color-input-focus)]
                  transition" %>
          </div>

          <%# Last name %>
          <div class="flex-1">
            <%= form.label :lastname, "Last name",
                  class: "block text-sm font-semibold mb-[var(--spacing-2)]
                          text-[var(--color-label)]" %>
            <%= form.text_field :lastname,
                  autocomplete: "family-name",
                  placeholder: "Mensah",
                  class: "w-full px-4 py-2 pr-10 text-sm
                  bg-[var(--color-input-bg)]
                  text-[var(--color-text-heading)]
                  border border-[var(--color-input-border)]
                  rounded-lg focus:outline-none 
                  focus:ring-2 focus:ring-[var(--color-input-focus)]
                  transition" %>
          </div>
        </div>

        <%# ── Email ── %>
        <div class="mb-[var(--spacing-4)]">
          <%= form.label :email, "Email address",
                class: "block text-sm font-semibold mb-[var(--spacing-2)]
                        text-[var(--color-label)]" %>
          <%= form.email_field :email,
                autocomplete: "email",
                placeholder: "you@example.com",
                class: "w-full px-4 py-2 pr-10 text-sm
                  bg-[var(--color-input-bg)]
                  text-[var(--color-text-heading)]
                  border border-[var(--color-input-border)]
                  rounded-lg focus:outline-none 
                  focus:ring-2 focus:ring-[var(--color-input-focus)]
                  transition" %>
        </div>

        <%# ── Password ── %>
        <%# autocomplete: "new-password" tells the browser this is a NEW password
            field, not a login — prevents it autofilling with saved passwords %>
        <div class="mb-[var(--spacing-4)]">
          <%= form.label :password, "Password",
                class: "block text-sm font-semibold mb-[var(--spacing-2)]
                        text-[var(--color-label)]" %>
          <%= render "shared/password_field",
                form: form,
                field_name: :password,
                placeholder: "At least 6 characters" %>
          <% if @minimum_password_length %>
            <p class="mt-1 text-xs text-[var(--color-text-muted)]">
              Minimum <%= @minimum_password_length %> characters
            </p>
          <% end %>
        </div>

        <%# ── Password confirmation ── %>
        <%# Devise validates that this matches :password before saving %>
        <div class="mb-[var(--spacing-6)]">
          <%= form.label :password_confirmation, "Confirm password",
                class: "block text-sm font-semibold mb-[var(--spacing-2)]
                        text-[var(--color-label)]" %>
          <%= render "shared/password_field",
                form: form,
                field_name: :password_confirmation,
                placeholder: "Re-enter your password" %>
        </div>

        <%# ── Submit ── %>
        <%= form.submit "Create account",
              class: "w-full py-[var(--spacing-3)]
                      bg-[var(--color-accent)]
                      hover:bg-[var(--color-accent-hover)]
                      text-[var(--color-text-on-accent)]
                      text-sm font-semibold
                      rounded-[var(--radius-md)]
                      shadow-[var(--shadow-btn)]
                      cursor-pointer
                      transition-colors duration-200" %>

      <% end %>
    </div>

    <%# ── Sign in link (below card) ── %>
    <%# <p class="text-center mt-[var(--spacing-6)]
              text-sm text-[var(--color-text-muted)]">
      Already have an account?
      <%= link_to "Sign in",
            new_user_session_path,
            class: "font-semibold text-[var(--color-accent)]
                    hover:text-[var(--color-accent-hover)]
                    transition-colors duration-200" 
    </p> %>

  <%= render "devise/shared/links" %>
  </div>
</div>
