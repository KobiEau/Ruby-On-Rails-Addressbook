<div class="min-h-screen flex items-center justify-center
            bg-[var(--color-surface)]
            px-4 py-[var(--spacing-8)]">

  <div class="w-full max-w-md">
    <%# Header %>
    <div class="text-center mb-[var(--spacing-6)]">
      <h1 class="text-2xl font-bold tracking-tight
                  text-[var(--color-text-base)]">
        <span class="text-[var(--color-accent)]">A</span>ddressbook
      </h1>
      <p class="mt-1 text-sm text-[var(--color-text-muted)]">
        Unlock your account
      </p>
    </div>

    <div class="bg-[var(--color-surface-card)]
                rounded-[var(--radius-lg)]
                shadow-[var(--shadow-card)]
                px-[var(--spacing-8)] py-[var(--spacing-8)]">
        <%= render "shared/error_block", 
            record: resource,
            message: "prevented your unlock request from being sent"%>
        <p class="text-sm text-[var(--color-text-body)] mb-[var(--spacing-6)]">
          Enter your email address and we'll send you a link to unlock your account.
        </p>
        <%= form_for(resource,
                      as: resource_name,
                      url: user_unlock_path,
                      html: {method: :post}) do |form|%>
          <div class="mb-[var(--spacing-6)]">
            <%= form.label :email, "Email address",
                  class:"block text-sm font-semibold mb-[var(--spacing-3)]
                        text-[var(--color-label)]"%>
            <%= form.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "you@example.com",
                  class: "w-full px-[var(--spacing-3)] py-[var(--spacing-3)]
                        bg-[var(--color-input-bg)]
                        border border-[var(--color-input-border)]
                        rounded-[var(--radius-md)]
                        text-sm text-[var(--color-text-heading)]
                        placeholder:text-[var(--color-text-muted)]
                        focus:outline-none focus:ring-2
                        focus:ring-[var(--color-input-focus)]
                        transition-shadow duration-200" %>
          </div>

            <%= form.submit "Send unlock instrutions",
                 class: "w-full py-[var(--spacing-3)]
                      bg-[var(--color-accent)]
                      hover:bg-[var(--color-accent-hover)]
                      text-[var(--color-text-on-accent)]
                      text-sm font-semibold
                      rounded-[var(--radius-md)]
                      shadow-[var(--shadow-btn)]
                      cursor-pointer
                      transition-colors duration-200" %>
        <% end %>
    </div>

    <div class="text-center mt-[var(--spacing-6)]
                text-sm text-[var(--color-text-muted)]
                flex flex-col gap-[var(--spacing-2)]">
      <%= link_to "Back to sign in",
          new_user_session_path,
          class: "font-semibold text-[var(--color-accent)]
                  hover:text-[var(--color-accent-hover)]
                  transition-colors duration-200" %>
    </div>
    <%= render "devise/shared/links" %>
  </div>
</div>
