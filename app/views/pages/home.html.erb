<%# app/views/pages/home.html.erb %>

<!DOCTYPE html>
<html>
<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
</html>

<style>
  .home-page {
    font-family: 'DM Sans', sans-serif;
    background: #ffffff;
    color: #0f172a;
  }
  
  .home-page h1, .home-page h2, .home-page h3 {
    font-family: 'Fraunces', serif;
  }

  .hero-gradient {
    background: radial-gradient(ellipse at 70% 50%, #d1fae5 0%, #ffffff 60%);
  }

  .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.10);
  }

  .feature-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .step-number {
    font-family: 'Fraunces', serif;
    font-size: 4rem;
    line-height: 1;
    color: #d1fae5;
    font-weight: 700;
  }

  .browser-bar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .mock-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .fade-up { animation: fadeUp 0.6s ease forwards; }
  .fade-up-delay-1 { animation: fadeUp 0.6s ease 0.1s forwards; opacity: 0; }
  .fade-up-delay-2 { animation: fadeUp 0.6s ease 0.2s forwards; opacity: 0; }
  .fade-up-delay-3 { animation: fadeUp 0.6s ease 0.3s forwards; opacity: 0; }
</style>

<div class="home-page">

  <%# ── Navbar ── %>
  <nav class="sticky top-0 z-50 bg-white border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <span class="text-lg font-bold tracking-tight" style="font-family: 'Fraunces', serif;">
        <span class="text-[var(--color-accent)]">A</span>ddressbook
      </span>
      <div class="flex items-center gap-3">
        <%= link_to "Sign In", new_user_session_path,
              class: "px-4 py-2 text-sm font-medium text-gray-600
                      border border-gray-200 rounded-lg
                      hover:border-gray-400 hover:text-gray-900
                      transition-all duration-200" %>
        <%= link_to "Get Started", new_user_registration_path,
              class: "px-4 py-2 text-sm font-semibold text-white
                      bg-[var(--color-accent)]
                      rounded-lg transition-all duration-200"
               %>
      </div>
    </div>
  </nav>

  <%# ── Hero ── %>
  <section class="hero-gradient min-h-[88vh] flex items-center">
    <div class="max-w-6xl mx-auto px-6 py-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <%# Left — copy %>
      <div>
        <span class="inline-block text-xs font-semibold tracking-widest uppercase
                     bg-[var(--color-accent-subtle)] border border-[var(--color-accent)] text-[var(--color-accent-hover)]
                     px-3 py-1 rounded-full mb-6 fade-up">
          Contact Management
        </span>
        <h1 class="text-5xl lg:text-6xl font-bold leading-tight text-gray-900 mb-6 fade-up-delay-1"
            style="letter-spacing: -0.02em;">
          Manage your contacts<br>
          <em class="not-italic text-[var(--color-accent)]">with confidence.</em>
        </h1>
        <p class="text-lg text-gray-500 leading-relaxed mb-10 fade-up-delay-2" style="max-width: 440px;">
          A clean, secure address book for professionals. Store, search, and organise
          your contacts — all in one place.
        </p>
        <div class="flex items-center gap-4 fade-up-delay-3">
          <%= link_to "Get Started Free", new_user_registration_path,
                class: "px-6 py-3 text-sm font-semibold text-white rounded-lg
                        shadow-lg transition-all duration-200
                        bg-[var(--color-accent)]
                        hover:shadow-xl hover:-translate-y-0.5"
            %>
          <%= link_to "Sign In →", new_user_session_path,
                class: "px-6 py-3 text-sm font-semibold text-gray-600
                        hover:text-gray-900 transition-colors duration-200" %>
        </div>
      </div>

      <%# Right — screenshot mock %>
      <div class="fade-up-delay-2">
        <div class="rounded-xl overflow-hidden shadow-2xl border border-gray-200"
             style="background: #0f172a=;">

          <%# Browser bar %>
          <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10"
               style="background: #1e293b;">
            <span class="browser-bar-dot" style="background: #ef4444;"></span>
            <span class="browser-bar-dot" style="background: #f59e0b;"></span>
            <span class="browser-bar-dot" style="background: #22c55e;"></span>
            <div class="flex-1 mx-4 bg-white/10 rounded px-3 py-1 text-xs text-white/40">
              addressbook.app/contacts
            </div>
            <span class="text-xs font-semibold px-3 py-1 rounded
                        bg-[var(--color-accent)]"
                  >
              + New
            </span>
          </div>

          <%# Toolbar %>
          <div class="px-4 pt-4 pb-3 flex items-center gap-3">
            <div class="flex-1 flex items-center gap-2 bg-black/5 border border-black/10
                        rounded-lg px-3 py-2">
              <svg class="w-3.5 h-3.5 text-black/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <span class="text-xs text-black/30">Search contacts...</span>
            </div>
          </div>

          <%# Contact cards grid %>
          <div class="px-4 pb-5 grid grid-cols-3 gap-3">
            <% [
              { initials: "JD", name: "John Doe",     phone: "020 123 4567", color: "#7c3aed", bg: "#ede9fe" },
              { initials: "AS", name: "Amy Smith",    phone: "054 987 6543", color: "#0891b2", bg: "#cffafe" },
              { initials: "KM", name: "Kwame M.",     phone: "024 456 7890", color: "#16a34a", bg: "#dcfce7" },
              { initials: "OB", name: "Ola Benson",   phone: "050 321 0987", color: "#dc2626", bg: "#fee2e2" },
              { initials: "RM", name: "Rose Mensah",  phone: "027 654 3210", color: "#d97706", bg: "#fef3c7" },
              { initials: "YA", name: "Yaw Asante",   phone: "023 789 0123", color: "#7c3aed", bg: "#ede9fe" },
            ].each do |contact| %>
              <div class="rounded-lg p-3 flex flex-col gap-2"
                   style="background: #fffffa; border: 1px solid rgba(255,255,255,0.07);">
                <div class="mock-avatar"
                     style="background: <%= contact[:bg] %>; color: <%= contact[:color] %>;">
                  <%= contact[:initials] %>
                </div>
                <div>
                  <p class="text-xs font-semibold text-black leading-tight"><%= contact[:name] %></p>
                  <p class="text-xs text-black/40 mt-0.5"><%= contact[:phone] %></p>
                </div>
                <div class="mt-1 text-center text-xs font-medium py-1 rounded text-white"
                     style="background: #0369a1;">
                  View More
                </div>
              </div>
            <% end %>
          </div>

        </div>
      </div>

    </div>
  </section>

  <%# ── Features ── %>
  <section class="py-24 bg-gray-50">
    <div class="max-w-6xl mx-auto px-6">

      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4" style="letter-spacing: -0.02em;">
          Everything you need
        </h2>
        <p class="text-gray-500 text-lg" style="max-width: 480px; margin: 0 auto;">
          Built for people who take their professional relationships seriously.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6 max-w-3xl mx-auto">

        <% [
          {
            icon: "📇",
            title: "Store & Organise",
            desc: "Keep all your contacts in one clean, searchable place. Add names, phone numbers, and categories."
          },
          {
            icon: "🔍",
            title: "Search & Filter",
            desc: "Find any contact instantly. Search by name across your entire address book in real time."
          },
          {
            icon: "📤",
            title: "Import & Export",
            desc: "Bring your existing contacts in via CSV. Export anytime — your data is always yours."
          },
          {
            icon: "🔒",
            title: "Secure & Private",
            desc: "Your contacts are isolated to your account. Nobody else can see your data — ever."
          }
        ].each do |feature| %>
          <div class="feature-card bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <div class="text-3xl mb-4"><%= feature[:icon] %></div>
            <h3 class="text-base font-bold text-gray-900 mb-2"><%= feature[:title] %></h3>
            <p class="text-sm text-gray-500 leading-relaxed"><%= feature[:desc] %></p>
          </div>
        <% end %>

      </div>
    </div>
  </section>

  <%# ── How It Works ── %>
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">

      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4" style="letter-spacing: -0.02em;">
          Up and running in minutes
        </h2>
        <p class="text-gray-500 text-lg">Three steps is all it takes.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <% [
          { number: "01", title: "Sign Up",          desc: "Create your free account in under a minute. No credit card required." },
          { number: "02", title: "Add Contacts",     desc: "Add contacts manually or import your existing list from a CSV file." },
          { number: "03", title: "Manage Anywhere",  desc: "Access your address book from any device, any time." }
        ].each do |step| %>
          <div class="relative">
            <div class="step-number mb-2 "><%= step[:number] %></div>
            <h3 class="text-lg font-bold text-gray-900 mb-2"><%= step[:title] %></h3>
            <p class="text-sm text-gray-500 leading-relaxed"><%= step[:desc] %></p>
          </div>
        <% end %>
      </div>

    </div>
  </section>

  <%# ── CTA Banner ── %>
  <section class="py-24" style="background: #0f172a;">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-4" style="letter-spacing: -0.02em; font-family: 'Fraunces', serif;">
        Ready to get organised?
      </h2>
      <p class="text-gray-400 text-lg mb-10">
        Join professionals who trust Addressbook to manage their contacts.
      </p>
      <div class="flex items-center justify-center gap-4">
        <%= link_to "Create Free Account", new_user_registration_path,
              class: "px-8 py-3 text-sm font-semibold rounded-lg transition-all duration-200
                      bg-[var(--color-accent)]
                      hover:-translate-y-0.5"
              %>
        <%= link_to "Sign In →", new_user_session_path,
              class: "px-8 py-3 text-sm font-semibold text-gray-400
                      hover:text-white transition-colors duration-200" %>
      </div>
    </div>
  </section>

  <%# ── Footer ── %>
  <footer class="bg-white border-t border-gray-100 py-8">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-sm font-bold" style="font-family: 'Fraunces', serif;">
        <span class="text-[var(--color-accent)]">A</span>ddressbook
      </span>
      <p class="text-xs text-gray-400">
        © <%= Date.today.year %> Addressbook. Built with Rails.
      </p>
      <div class="flex items-center gap-4">
        <%= link_to "Sign In", new_user_session_path,
              class: "text-xs text-gray-400 hover:text-gray-700 transition-colors duration-200" %>
        <%= link_to "Get Started", new_user_registration_path,
              class: "text-xs text-gray-400 hover:text-gray-700 transition-colors duration-200" %>
      </div>
    </div>
  </footer>

</div>