<% record = local_assigns[:record] %>

<% if record.present?%>
  <div class="flex items-center mb-4">
    <div class="<%= contact_initials_color(record)%> text-[var(--color-text-white)] 
                rounded-full w-12 h-12 flex items-center justify-center font-bold 
                text-lg shrink-0">
      <%= contact_initials(record) %>
    </div>
  </div>

  <div class="ml-4">
    <h3 class="text-lg font-bold text-[var(--color-text-heading)]">
      <%= record.firstname%> <%= record.lastname%>
    </h3>
    <% if record.email.present? %>
    <p class="text-sm text-[var(--color-text-body)]">
      <%= record.email %>
    <p>
    <%end %>
  </div>

  
<% end %>