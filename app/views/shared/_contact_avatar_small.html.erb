<% record = local_assigns[:record] %>

<% if record.present?%>
  <div class="flex items-center">
    <div class="<%= contact_initials_color(record)%> text-[var(--color-text-white)] 
                rounded-full w-8 h-8 flex items-center justify-center font-bold 
                text-xs shrink-0">
      <%= contact_initials(record) %>
    </div>
    
    <div class="ml-4">
      <h3 class="text-xs font-semibold text-[var(--color-text-heading)]">
        <%= record.firstname%> <%= record.lastname%>
      </h3>
    </div>
  </div>


<% end %>